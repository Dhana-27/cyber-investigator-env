# ════════════════════════════════════════════════════════════════════════════
# OpenEnv AI Cyber Investigator Environment Configuration
# ════════════════════════════════════════════════════════════════════════════

# ────────────────────────────────────────────────────────────────────────────
# REQUIRED: LLM API Configuration
# The inference script MUST read these environment variables. 
# No hardcoded defaults for HF_TOKEN (security best practice).
# ────────────────────────────────────────────────────────────────────────────

# API endpoint for LLM service
API_BASE_URL=https://api.openai.com/v1

# Model identifier to use for inference
MODEL_NAME=gpt-4o-mini

# API Key for OpenAI (or compatible service)
# For OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Alternative: Hugging Face Token (if using HF inference endpoint)
# For HuggingFace: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# ────────────────────────────────────────────────────────────────────────────
# Optional: Task Configuration
# ────────────────────────────────────────────────────────────────────────────

# Task for inference script to focus on (if not set, defaults to "fraud")
# Valid values: fraud, ip_trace, account_link
INVESTIGATOR_TASK=fraud

# ────────────────────────────────────────────────────────────────────────────
# Optional: Server Configuration
# ────────────────────────────────────────────────────────────────────────────

# Server host and port
HOST=0.0.0.0
PORT=7860
WORKERS=1

# ════════════════════════════════════════════════════════════════════════════
# INSTRUCTIONS
# ════════════════════════════════════════════════════════════════════════════
# 1. Copy this file to .env in the project root
# 2. Fill in your actual API keys
# 3. Run: python inference.py
#
# For local testing without real LLM:
#   API_BASE_URL=http://localhost:8000/v1 (if using local llama-cpp-python, etc.)
#
# For Hugging Face Inference API:
#   API_BASE_URL=https://api-inference.huggingface.co/v1
#   MODEL_NAME=your-model-name
#   HF_TOKEN=your-token
#
# ════════════════════════════════════════════════════════════════════════════

